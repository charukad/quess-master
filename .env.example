# NextAuth uses VERCEL_URL automatically on Vercel. Set this locally and when
# using a custom production domain.
NEXTAUTH_URL=http://localhost:3006
NEXTAUTH_SECRET=replace-with-a-long-random-secret

MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/quiz_master?retryWrites=true&w=majority
# Local-only workaround for networks whose default resolver cannot resolve
# Atlas SRV records. Do not set this on Vercel unless it is actually required.
MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
